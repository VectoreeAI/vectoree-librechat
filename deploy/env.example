# 由 CI 在第一次部署时复制成 /opt/vectoree-librechat/.env。
# 每次部署 CI 都会覆盖这些值：
#   LIBRECHAT_IMAGE
#   VECTOREE_API_URL：dev -> https://vectoree.net，main -> https://vectoree.ai
#   DEPLOY_MODE=cloud
# JWT_SECRET、JWT_REFRESH_SECRET、CREDS_KEY、CREDS_IV 为空时，部署脚本只生成一次。
# DOMAIN_CLIENT 和 DOMAIN_SERVER 按浏览器实际入口填写，CI 不覆盖。
LIBRECHAT_IMAGE=
VECTOREE_API_URL=https://vectoree.ai
LIBRECHAT_PORT=5175
DEPLOY_MODE=cloud
ALLOW_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
DOMAIN_CLIENT=
DOMAIN_SERVER=
