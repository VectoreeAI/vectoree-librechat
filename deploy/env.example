# 由 CI 在第一次部署时复制成 /opt/vectoree-librechat/.env。
# 每次部署 CI 都会覆盖这些值：
#   LIBRECHAT_IMAGE
#   VECTOREE_API_URL：dev -> https://vectoree.net，main -> https://vectoree.ai
#   DEPLOY_MODE=cloud
# JWT_SECRET、JWT_REFRESH_SECRET、CREDS_KEY、CREDS_IV、MONGO_ROOT_PASSWORD 为空时，部署脚本只生成一次。
# MONGO_URI 由部署脚本根据 MONGO_ROOT_* 写入（含 authSource=admin）。
# DOMAIN_CLIENT 和 DOMAIN_SERVER 按浏览器实际入口填写，CI 不覆盖。
# 若服务器上仍是旧的 Mongo --noauth 数据卷，需重建 mongo 卷后再部署。
LIBRECHAT_IMAGE=
VECTOREE_API_URL=https://vectoree.ai
LIBRECHAT_PORT=5175
DEPLOY_MODE=cloud
ALLOW_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
MONGO_ROOT_USER=librechat
MONGO_ROOT_PASSWORD=
MONGO_URI=
DOMAIN_CLIENT=
DOMAIN_SERVER=
